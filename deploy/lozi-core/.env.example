# IP des Docker-LXC eintragen, über die Home Assistant Lozi-Core erreicht (z. B. 10.0.0.90).
# Andere Host-Header lehnt der MCP-Endpunkt mit 421 ab (Schutz gegen DNS-Rebinding).
LOZI_ALLOWED_HOSTS=10.0.0.90:*,localhost:*,127.0.0.1:*

# Bekannte Bildschirme, der erste ist der Standard.
LOZI_DISPLAYS=tv,beamer,roehre,boxautomat

# Token für POST /api/zustand (Home Assistant meldet Satelliten-Zustände). Langes Zufallswort wählen.
LOZI_API_TOKEN=bitte-aendern

LOZI_LOG_LEVEL=INFO
